{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": [
        "src/*"
      ],
      "@shared/*": [
        "../shared/src/*"
      ]
    },
    "rootDirs": [
      "src",
      "../shared/src"
    ]
  },
  "include": [
    "src",
    "../shared/src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "temp"
  ]
}
