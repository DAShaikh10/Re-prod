{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Re-prod",
  "version": "0.1.0",
  "identifier": "com.reprod.app",
  "build": {
    "beforeDevCommand": "(cd .. && npm run dev:client)",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "(cd .. && npm run build:client)",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Re-prod",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}
