{
  "name": "re-prod",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered R Analysis IDE",
  "workspaces": [
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"cargo run -p reprod-server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=client",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "shared/src/*"
      ],
      "@server/*": [
        "server/src/*"
      ]
    },
    "rootDirs": [
      "server/src",
      "shared/src"
    ]
  }
}
